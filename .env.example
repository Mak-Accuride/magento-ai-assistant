# Application
DEBUG=true
PRODUCTION=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Security (Change in production!)
API_KEY=your-secure-api-key-here
RATE_LIMIT_PER_MINUTE=60

# Magento API (from Week 1-2)
MAGENTO_BASE_URL=https://your-magento-instance.com
MAGENTO_API_TOKEN=your-magento-token

# FAISS/Embeddings (from Week 3)
FAISS_INDEX_PATH=./data/embeddings/faiss_index.bin
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATA_DIR=./data

# OpenAI (from Week 4)
OPENAI_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7

# Redis/Memory (from Week 5)
REDIS_URL=redis://localhost:6379/0
SESSION_TIMEOUT=3600
MAX_HISTORY_LENGTH=10

# Logging
LOG_LEVEL=INFO